---
// Paleta del sitio actual de Muelle Siete: azul marino #1F425D, cian #4AB9CF,
// azul del logo #1E73BE y coral #FD7062. Tipografía: Montserrat.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-montserrat);
    --aw-font-serif: var(--font-montserrat);
    --aw-font-heading: var(--font-montserrat);

    --aw-color-primary: #187a91;
    --aw-color-secondary: #1f425d;
    --aw-color-accent: #4ab9cf;

    --aw-color-text-heading: #1f425d;
    --aw-color-text-default: #2b3a47;
    --aw-color-text-muted: rgb(43 58 71 / 88%);
    --aw-color-bg-page: #ffffff;

    --aw-color-bg-page-dark: #15304a;

    ::selection {
      background-color: rgb(74 185 207 / 30%);
    }
  }

  .dark {
    --aw-font-sans: var(--font-montserrat);
    --aw-font-serif: var(--font-montserrat);
    --aw-font-heading: var(--font-montserrat);

    --aw-color-primary: #4ab9cf;
    --aw-color-secondary: #1e73be;
    --aw-color-accent: #4ab9cf;

    --aw-color-text-heading: #f5f7f9;
    --aw-color-text-default: #e2e8f0;
    --aw-color-text-muted: rgb(226 232 240 / 66%);
    --aw-color-bg-page: #15304a;
  }
</style>
