---
import { Icon } from 'astro-icon/components';
import { clients } from '~/data/muestra';
// Cotizador: el visitante arma su operación y la envía como solicitud.
// Prototipo: valida en el navegador y muestra confirmación. En producción se
// conecta a correo/CRM (p. ej. Netlify Forms, Formspree o un endpoint propio).
const services = [
  'Cargue / descargue',
  'Picking y alistamiento',
  'Cross docking',
  'Packing y co-packing',
  'Almacenaje y paletización',
  'Inventarios (entradas/salidas)',
  'Logística inversa',
  'Auxiliares de distribución',
  'Inspección de cargues',
  'Gestión documental',
  'Aseo industrial',
  'Servicios generales',
];
const input = 'mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 bg-white focus:border-cyan focus:ring-2 focus:ring-cyan/30 outline-none transition';
---

<section class="relative bg-navy text-white">
  <div class="absolute inset-0 opacity-[0.06] [background-image:repeating-linear-gradient(135deg,#fff_0_2px,transparent_2px_22px)]" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-16 md:py-24 grid gap-12 lg:grid-cols-[1fr_1.3fr]">
    <div data-reveal="left">
      <h2 class="font-heading text-4xl md:text-5xl font-extrabold leading-[1.05]">Arma tu operación en 60 segundos.</h2>
      <p class="mt-5 text-lg text-white/75 max-w-md">
        Elige los servicios, cuéntanos el volumen y nuestro equipo comercial te contacta con una propuesta.
      </p>
      <ul class="mt-8 space-y-4 text-white/90">
        <li class="flex gap-3"><span class="font-heading font-extrabold text-cyan">01</span> Revisamos tu solicitud</li>
        <li class="flex gap-3"><span class="font-heading font-extrabold text-cyan">02</span> Agendamos una visita a tu operación</li>
        <li class="flex gap-3"><span class="font-heading font-extrabold text-cyan">03</span> Te enviamos la propuesta con indicadores</li>
      </ul>

      <!-- Confianza junto al formulario: solo datos publicados por la empresa -->
      <div class="mt-10 rounded-2xl border border-white/15 bg-white/[0.04] p-6">
        <dl class="grid grid-cols-2 gap-4">
          <div>
            <dd class="font-heading text-3xl font-extrabold text-cyan">12.400</dd>
            <dt class="text-sm text-white/80">servicios prestados</dt>
          </div>
          <div>
            <dd class="font-heading text-3xl font-extrabold text-cyan">150</dd>
            <dt class="text-sm text-white/80">personas en operación</dt>
          </div>
        </dl>
        <p class="mt-5 text-sm text-white/80">Han confiado en nosotros {clients.slice(0, 5).join(', ')} y más.</p>
        <p class="mt-4 flex items-center gap-2 text-sm text-white/80">
          <Icon name="tabler:lock" class="w-4 h-4 text-cyan" aria-hidden="true" /> Tus datos se tratan según la Ley 1581 de 2012.
        </p>
      </div>
    </div>

    <div data-reveal="right" class="rounded-2xl bg-white text-slate-800 p-6 sm:p-8 shadow-2xl">
      <form data-demo-form novalidate>
        <fieldset>
          <legend class="font-heading font-bold text-lg text-navy">1. ¿Qué necesitas?</legend>
          <div class="mt-3 flex flex-wrap gap-2" data-required-group>
            {
              services.map((s) => (
                <label class="cursor-pointer">
                  <input type="checkbox" name="servicio" value={s} class="peer sr-only" />
                  <span class="inline-block rounded-full border border-slate-300 px-3.5 py-1.5 text-sm transition peer-checked:border-navy peer-checked:bg-navy peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-cyan hover:border-cyan">
                    {s}
                  </span>
                </label>
              ))
            }
          </div>
          <p data-group-error class="hidden mt-2 text-sm font-medium text-coral-ink" role="alert">Elige al menos un servicio para poder cotizar.</p>
        </fieldset>

        <fieldset class="mt-7 grid gap-5 sm:grid-cols-2">
          <legend class="font-heading font-bold text-lg text-navy mb-3 sm:col-span-2">2. Tu volumen</legend>
          <label class="block text-sm font-medium sm:col-span-2">
            Personas en operación: <output class="font-bold text-cyan-ink" data-range-out>10</output>
            <input name="personas" type="range" min="2" max="100" value="10" class="mt-2 w-full accent-[#1f425d]" oninput="this.previousElementSibling.textContent=this.value" />
          </label>
          <label class="block text-sm font-medium">
            Sector
            <select name="sector" class={input}>
              <option>Consumo masivo</option>
              <option>E-commerce / última milla</option>
              <option>Licores y bebidas</option>
              <option>Industrial / manufactura</option>
              <option>Transporte y paquetería</option>
              <option>Otro</option>
            </select>
          </label>
          <label class="block text-sm font-medium">
            ¿Cuándo arrancas?
            <select name="inicio" class={input}>
              <option>Lo antes posible</option>
              <option>En 1 mes</option>
              <option>En 2–3 meses</option>
              <option>Solo estoy explorando</option>
            </select>
          </label>
        </fieldset>

        <fieldset class="mt-7 grid gap-5 sm:grid-cols-2">
          <legend class="font-heading font-bold text-lg text-navy mb-3 sm:col-span-2">3. Tus datos</legend>
          <label class="block text-sm font-medium">Nombre<input name="nombre" required autocomplete="name" class={input} /></label>
          <label class="block text-sm font-medium">Empresa<input name="empresa" required autocomplete="organization" class={input} /></label>
          <label class="block text-sm font-medium">Correo<input name="email" type="email" required autocomplete="email" class={input} /></label>
          <label class="block text-sm font-medium">Teléfono<input name="telefono" type="tel" required autocomplete="tel" class={input} /></label>
        </fieldset>

        <label class="mt-6 flex items-start gap-2 text-xs text-slate-500">
          <input type="checkbox" name="habeas" required class="mt-0.5 accent-[#1f425d]" />
          <span>He leído y acepto la <a href="/politica-de-privacidad" class="underline text-cyan-ink">Política de Privacidad</a> y autorizo el tratamiento de mis datos según la Ley 1581 de 2012.</span>
        </label>

        <button type="submit" class="group mt-6 w-full inline-flex items-center justify-center gap-2 rounded-lg bg-navy px-6 py-4 font-bold text-white text-lg transition hover:bg-cyan hover:text-navy">
          Solicitar cotización
        </button>
      </form>

      <div data-form-ok tabindex="-1" role="status" class="hidden py-10 text-center outline-none">
        <div class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-cyan/15 text-cyan-ink text-3xl">✓</div>
        <h3 class="font-heading mt-5 text-2xl font-extrabold text-navy">Solicitud de cotización enviada</h3>
        <p class="mt-2 text-muted">Nuestro equipo comercial te contactará pronto.</p>
      </div>
    </div>
  </div>
</section>
