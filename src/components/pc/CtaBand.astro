---
import { Icon } from 'astro-icon/components';

export interface Props {
  title?: string;
  text?: string;
}
const {
  title = '¿Listo para tercerizar tu operación?',
  text = 'Cuéntanos qué necesitas y te enviamos una propuesta.',
} = Astro.props;
---

<section class="bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
    <div data-reveal="zoom" class="relative overflow-hidden flex flex-col md:flex-row items-start md:items-center justify-between gap-6 rounded-3xl bg-navy p-8 md:p-12 text-white">
      <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-cyan/20 " aria-hidden="true"></div>
      <div class="absolute right-40 -bottom-20 h-40 w-40 rounded-full bg-coral/20" aria-hidden="true"></div>
      <div class="relative">
        <h2 class="font-heading text-3xl md:text-4xl font-extrabold">{title}</h2>
        <p class="mt-2 text-white/80">{text}</p>
      </div>
      <div class="relative flex flex-col sm:flex-row gap-3 shrink-0">
        <a href="/cotizar" class="group inline-flex items-center justify-center gap-2 rounded-lg bg-cyan px-6 py-4 font-bold text-navy hover:bg-white transition">
          Cotizar operación
        </a>
        <a href="/contactanos" class="inline-flex items-center justify-center gap-2 rounded-lg border border-white/30 px-6 py-4 font-semibold hover:bg-white/10 transition">
          Contáctanos
        </a>
      </div>
    </div>
  </div>
</section>
