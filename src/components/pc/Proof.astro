---
// Prueba social: un caso de éxito destacado + testimonios.
// Mientras el contenido sea plantilla (`placeholder: true` en ~/data/muestra),
// cada bloque muestra la marca "Ejemplo" para que no se publique como real.
import { Icon } from 'astro-icon/components';
import Eyebrow from '~/components/pc/Eyebrow.astro';
import { img, caseStudy, testimonials, clients } from '~/data/muestra';

export interface Props {
  title?: string;
  showClients?: boolean;
}
const { title = 'Empresas que ya tercerizan su operación con nosotros', showClients = true } = Astro.props;
const initials = (n: string) =>
  n
    .split(' ')
    .map((w) => w[0])
    .slice(0, 2)
    .join('');
---

<section class="bg-slate-50" aria-labelledby="prueba-social">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-20 md:py-24">
    <div data-reveal class="max-w-2xl">
      <Eyebrow>Resultados</Eyebrow>
      <h2 id="prueba-social" class="font-heading mt-3 text-3xl md:text-4xl font-extrabold leading-tight text-navy">{title}</h2>
    </div>

    <!-- Caso de éxito -->
    <article data-reveal class="relative mt-10 grid overflow-hidden rounded-3xl bg-navy text-white lg:grid-cols-5">
      {caseStudy.placeholder && <span class="absolute right-4 top-4 z-10 rounded-full bg-coral-ink px-3 py-1 text-xs font-bold">Ejemplo: reemplazar con un caso real</span>}
      <div class="zoom-img lg:col-span-2 min-h-56">
        <img src={img(caseStudy.photo, 900)} alt="" class="h-full w-full object-cover" loading="lazy" />
      </div>
      <div class="lg:col-span-3 p-8 md:p-10">
        <p class="text-sm font-semibold text-cyan">Caso de éxito: {caseStudy.client}</p>
        <h3 class="font-heading mt-2 text-2xl md:text-3xl font-extrabold">{caseStudy.title}</h3>
        <dl class="mt-6 grid gap-5 sm:grid-cols-2 text-white/85">
          <div>
            <dt class="font-semibold text-white">El reto</dt>
            <dd class="mt-1 text-sm">{caseStudy.challenge}</dd>
          </div>
          <div>
            <dt class="font-semibold text-white">Lo que hicimos</dt>
            <dd class="mt-1 text-sm">{caseStudy.solution}</dd>
          </div>
        </dl>
        <dl class="mt-8 grid grid-cols-3 gap-4 border-t border-white/15 pt-6">
          {
            caseStudy.metrics.map((m) => (
              <div>
                <dd class="font-heading text-3xl md:text-4xl font-extrabold text-cyan">{m.value}</dd>
                <dt class="mt-1 text-xs sm:text-sm text-white/80">{m.label}</dt>
              </div>
            ))
          }
        </dl>
      </div>
    </article>

    <!-- Testimonios -->
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        testimonials.map((t, i) => (
          <figure data-reveal style={`--d:${i * 100}ms`} class="relative flex flex-col rounded-2xl bg-white p-7 ring-1 ring-slate-200">
            {t.placeholder && <span class="absolute right-4 top-4 rounded-full bg-coral/15 px-2.5 py-0.5 text-xs font-semibold text-coral-ink">Ejemplo</span>}
            <Icon name="tabler:quote" class="w-8 h-8 text-cyan" aria-hidden="true" />
            <blockquote class="mt-4 flex-1 text-lg leading-relaxed text-navy">“{t.quote}”</blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <span class="grid h-11 w-11 place-items-center rounded-full bg-navy font-bold text-cyan" aria-hidden="true">{initials(t.name)}</span>
              <span>
                <span class="block font-semibold text-navy">{t.name}</span>
                <span class="block text-sm text-muted">{t.role}, {t.company}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <!-- Clientes (dato real del sitio actual) -->
    {
      showClients && (
        <div data-reveal class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3">
          <p class="text-sm font-semibold text-navy">Han confiado en nosotros:</p>
          {clients.slice(0, 8).map((c) => <span class="font-heading text-lg font-extrabold text-slate-600">{c}</span>)}
        </div>
      )
    }
  </div>
</section>
